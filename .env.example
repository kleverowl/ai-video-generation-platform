# Copy to .env (never commit .env). Values here are placeholders only.

# ── App (Oracle control plane) ──
APP_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://app:CHANGE_ME@localhost:5432/vidgen

# ── Google Cloud ──
GCP_PROJECT_ID=vidgen-dev
GCP_REGION=us-central1             # ADR-0003 (fallback region: europe-west4)
GCS_MODELS_BUCKET=vidgen-dev-models
GCS_WORK_BUCKET=vidgen-dev-work
CLOUD_RUN_GPU_JOB=gpu-worker
CLOUD_RUN_TTS_JOB=tts-worker
CLOUD_RUN_RENDER_JOB=render-worker
GOOGLE_APPLICATION_CREDENTIALS=./secrets/oracle-dispatcher.json   # MVP only; move to WIF before paid launch

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=
R2_BUCKET_OUTPUT=video-output
R2_BUCKET_BACKUPS=db-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGN_TTL_SECONDS=1800

# ── Cost controls ──
GPU_GLOBAL_DAILY_SECONDS_LIMIT=7200
GPU_PER_USER_DAILY_SECONDS_LIMIT=1800
GPU_MAX_CONCURRENCY=1
